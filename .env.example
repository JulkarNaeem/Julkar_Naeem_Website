# Local preview only. Never enable a filesystem store on Vercel.
CMS_LOCAL_STORE=1

# Run npm run admin:setup to generate these in .env.local.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Production: connect the same Neon PostgreSQL database used by enquiries.
DATABASE_URL=

# Optional owner-only social sign-in. These are server secrets, never NEXT_PUBLIC values.
# Production callbacks use https://admin.julkarnaeem.com/api/admin/oauth/PROVIDER/callback.
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_EMAIL=julkarnaeem.me@gmail.com
# Optional immutable Google subject. Required if using a non-Gmail address.
ADMIN_GOOGLE_SUB=
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
# Verified public GitHub account ID for JulkarNaeem (not a username).
ADMIN_GITHUB_ID=31064056
